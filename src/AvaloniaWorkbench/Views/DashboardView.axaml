<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AvaloniaWorkbench.ViewModels"
             xmlns:model="using:AvaloniaWorkbench.Models"
             x:Class="AvaloniaWorkbench.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">
  <ScrollViewer>
    <StackPanel Margin="28,0,28,28" Spacing="18">
      <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="14">
        <Border Grid.Column="0" Classes="card">
          <StackPanel Spacing="8">
            <TextBlock Text="演示模块" Classes="muted" />
            <TextBlock Text="7" FontSize="30" FontWeight="SemiBold" />
            <TextBlock Text="覆盖桌面应用核心能力" FontSize="12" Classes="muted" />
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Classes="card">
          <StackPanel Spacing="8">
            <TextBlock Text="模拟数据" Classes="muted" />
            <TextBlock Text="2,500" FontSize="30" FontWeight="SemiBold" />
            <TextBlock Text="支持筛选、排序和扩容" FontSize="12" Classes="muted" />
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Classes="card">
          <StackPanel Spacing="8">
            <TextBlock Text="运行模式" Classes="muted" />
            <TextBlock Text="本地" FontSize="30" FontWeight="SemiBold" />
            <TextBlock Text="核心功能不依赖远程服务" FontSize="12" Classes="muted" />
          </StackPanel>
        </Border>
        <Border Grid.Column="3" Classes="card">
          <StackPanel Spacing="8">
            <TextBlock Text="当前环境" Classes="muted" />
            <TextBlock Text="{Binding RuntimeLabel}" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="桌面端优先验证" FontSize="12" Classes="muted" />
          </StackPanel>
        </Border>
      </Grid>

      <Grid ColumnDefinitions="2*,*" ColumnSpacing="14">
        <Border Grid.Column="0" Classes="card">
          <StackPanel Spacing="14">
            <TextBlock Text="能力覆盖" Classes="section-title" />
            <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="12">
              <StackPanel Grid.Row="0" Spacing="4">
                <TextBlock Text="MVVM 与编译绑定" FontWeight="Medium" />
                <TextBlock Text="CommunityToolkit.Mvvm + Avalonia compiled bindings" Classes="muted" FontSize="12" />
              </StackPanel>
              <TextBlock Grid.Row="0" Grid.Column="1" Text="已启用" VerticalAlignment="Center" />

              <StackPanel Grid.Row="1" Spacing="4">
                <TextBlock Text="数据表格与筛选" FontWeight="Medium" />
                <TextBlock Text="DataGrid、搜索、状态过滤和数据扩容" Classes="muted" FontSize="12" />
              </StackPanel>
              <TextBlock Grid.Row="1" Grid.Column="1" Text="可交互" VerticalAlignment="Center" />

              <StackPanel Grid.Row="2" Spacing="4">
                <TextBlock Text="文件系统访问" FontWeight="Medium" />
                <TextBlock Text="原生目录选择器、异步扫描和文件信息展示" Classes="muted" FontSize="12" />
              </StackPanel>
              <TextBlock Grid.Row="2" Grid.Column="1" Text="可交互" VerticalAlignment="Center" />

              <StackPanel Grid.Row="3" Spacing="4">
                <TextBlock Text="跨平台发布" FontWeight="Medium" />
                <TextBlock Text="GitHub Actions 自动构建 Windows、Linux、macOS" Classes="muted" FontSize="12" />
              </StackPanel>
              <TextBlock Grid.Row="3" Grid.Column="1" Text="自动化" VerticalAlignment="Center" />
            </Grid>
          </StackPanel>
        </Border>

        <Border Grid.Column="1" Classes="card">
          <StackPanel Spacing="14">
            <TextBlock Text="最近活动" Classes="section-title" />
            <ItemsControl ItemsSource="{Binding Activities}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="model:ActivityEntry">
                  <Grid ColumnDefinitions="14,*" Margin="0,0,0,14">
                    <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource AccentFillColorDefaultBrush}" VerticalAlignment="Top" Margin="0,6,0,0" />
                    <StackPanel Grid.Column="1" Spacing="2">
                      <TextBlock Text="{Binding Title}" FontWeight="Medium" />
                      <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}" Classes="muted" FontSize="11" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
